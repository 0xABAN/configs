#!/bin/bash
# Run the pinned upstream Pi without personal resources or inherited credentials.
set -euo pipefail

# Resolve the ~/.local/bin symlink without requiring GNU readlink -f on macOS.
source_path="${BASH_SOURCE[0]}"
while [[ -L "$source_path" ]]; do
  source_dir="$(cd "$(dirname "$source_path")" && pwd)"
  source_path="$(readlink "$source_path")"
  [[ "$source_path" = /* ]] || source_path="$source_dir/$source_path"
done
install_dir="$(cd "$(dirname "$source_path")" && pwd)"
cli="$install_dir/node_modules/@earendil-works/pi-coding-agent/dist/cli.js"
if [[ ! -f "$cli" ]]; then
  printf 'Install the pinned release first: cd %q && npm ci --ignore-scripts\n' "$install_dir" >&2
  exit 1
fi
node="$(command -v node)"

# Do not honor an inherited TMPDIR that could sit inside a configured project.
run_dir="$(mktemp -d /tmp/pi-clean.XXXXXXXX)"
trap 'rm -rf -- "$run_dir"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# macOS aliases /tmp to /private/tmp; keep PWD and Node's cwd consistent.
run_dir="$(cd "$run_dir" && pwd -P)"
mkdir -p "$run_dir/home" "$run_dir/work" "$run_dir/tmp" "$run_dir/config" "$run_dir/cache" "$run_dir/agent"
cd "$run_dir/work"

# Keep terminal capabilities, but not API keys, NODE_OPTIONS, Pi overrides, or
# host integration variables. PATH remains available for ordinary development tools.
env -i \
  PATH="$PATH" \
  HOME="$run_dir/home" \
  USERPROFILE="$run_dir/home" \
  PWD="$run_dir/work" \
  TMPDIR="$run_dir/tmp" \
  TMP="$run_dir/tmp" \
  TEMP="$run_dir/tmp" \
  XDG_CONFIG_HOME="$run_dir/config" \
  XDG_CACHE_HOME="$run_dir/cache" \
  TERM="${TERM:-xterm-256color}" \
  COLORTERM="${COLORTERM:-}" \
  LANG="${LANG:-en_US.UTF-8}" \
  PI_CODING_AGENT_DIR="$run_dir/agent" \
  PI_OFFLINE=1 \
  PI_TELEMETRY=0 \
  "$node" "$cli" \
    --no-session --no-extensions --no-skills --no-prompt-templates \
    --no-themes --no-context-files "$@"
