{
  "lastChangelogVersion": "0.84.2",
  "theme": "woody",
  "defaultProvider": "xai",
  "defaultModel": "grok-4.5",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@tintinweb/pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    {
      "source": "npm:@aliou/pi-processes",
      "skills": []
    },
    {
      "source": "npm:pi-goal",
      "skills": []
    },
    "https://github.com/ShpetimA/pi-fff",
    "npm:pi-intercom",
    "https://github.com/nicobailon/pi-powerline-footer@8c9bda10fdfd2822e89334ec85f3da9f8ca49182",
    {
      "source": "npm:@dietrichgebert/ponytail",
      "skills": [
        "ponytail"
      ]
    },
    "https://github.com/nicobailon/pi-rewind-hook",
    "https://github.com/nicobailon/pi-skill-palette",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo"
  ],
  "powerline": {
    "preset": "default",
    "placement": "below",
    "disabledSegments": [
      "extension_statuses",
      "git",
      "cache_read"
    ],
    "context": {
      "format": "percent"
    },
    "git": {
      "showBranch": false,
      "showStaged": false,
      "showUnstaged": false,
      "showUntracked": false
    },
    "customItems": [
      {
        "id": "mode",
        "statusKey": "agent-mode",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": false
      },
      {
        "id": "thinking",
        "statusKey": "agent-thinking",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": false
      }
    ],
    "layout": {
      "left": [
        "custom:mode",
        "model",
        "custom:thinking",
        "shell_mode",
        "path",
        "queue",
        "context_pct",
        "cost"
      ]
    }
  },
  "skills": [
    "-skills/brand",
    "-skills/brief",
    "-skills/test-driven-development",
    "-skills/use-railway",
    "-skills/watch"
  ]
}
