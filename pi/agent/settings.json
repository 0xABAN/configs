{
  "lastChangelogVersion": "0.84.2",
  "theme": "earth",
  "defaultProvider": "xai",
  "defaultModel": "grok-4.5",
  "defaultThinkingLevel": "xhigh",
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:@tintinweb/pi-subagents",
    "npm:@juicesharp/rpiv-ask-user-question",
    "npm:@aliou/pi-processes",
    {
      "source": "npm:pi-goal",
      "skills": []
    },
    "https://github.com/ShpetimA/pi-fff",
    "npm:pi-intercom",
    "https://github.com/nicobailon/pi-powerline-footer@8c9bda1",
    "npm:@dietrichgebert/ponytail",
    "https://github.com/nicobailon/pi-rewind-hook",
    "https://github.com/nicobailon/pi-skill-palette",
    "https://github.com/nicobailon/pi-side-chat",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo"
  ],
  "powerline": {
    "preset": "default",
    "placement": "below",
    "disabledSegments": [
      "extension_statuses",
      "git",
      "cache_read"
    ],
    "context": {
      "format": "percent"
    },
    "git": {
      "showBranch": false,
      "showStaged": false,
      "showUnstaged": false,
      "showUntracked": false
    },
    "customItems": [
      {
        "id": "mode",
        "statusKey": "agent-mode",
        "position": "left",
        "selfColorize": true,
        "hideWhenMissing": false
      }
    ],
    "layout": {
      "left": [
        "custom:mode",
        "model",
        "thinking",
        "shell_mode",
        "path",
        "queue",
        "context_pct",
        "cost"
      ]
    }
  }
}
